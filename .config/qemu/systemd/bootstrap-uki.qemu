[QEMU]
machine=q35
nodefaults=
accel=kvm
cpu=host
m=2G
smp=2
nographic=
serial=mon:stdio
drive=if=pflash,format=raw,readonly=on,file=%h/bootstrap/uki/ovmf-fd/FV/OVMF_CODE.fd
drive=if=pflash,format=raw,snapshot=on,file=%h/bootstrap/uki/ovmf-fd/FV/OVMF_VARS.fd

[virtiofsd]
shared-dir=%h/bootstrap/uki/result/
tag=esp
sandbox=namespace
uid-map=:0:%U:1:
gid-map=:0:%G:1:
